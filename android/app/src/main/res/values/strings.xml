    <string name="cd_in_cache">In the play cache (plays offline)</string>
    <string name="dl_confirm_title">Download from Suno?</string>
    <string name="dl_confirm_text">This counts in your Suno download limit (Pro: 20 a month; a track already downloaded once doesn\'t count again). The file stays on this phone only (Android/data/com.soaresden.sunoauto/files/Music/Suno). Tip: download on the computer with SunoAAWeb instead — it goes to pCloud and every device gets it.</string>
    <string name="cache_legend">Icons in lists: ☁ in your pCloud folder · 📱 file on the phone · ⚡ in the play cache (plays offline). No icon: played by Suno\'s player.</string>
