    <string name="logout">Sign out (clears the cache)</string>
    <string name="not_connected">Not signed in.</string>
    <string name="sign_in_suno">Sign in to Suno</string>
    <string name="section_local">Sync local MP3 → Match with Suno</string>
    <string name="local_desc">Your files, for playback. Pick the folder that contains your workspace folders (in the picker, open ☰ on the left for pCloud, Drive…). Access is remembered: afterwards a simple “Sync folder” is enough.</string>
    <string name="folder_pattern_label">Folder name pattern (optional)</string>
    <string name="folder_pattern_placeholder">e.g. Suno - </string>
    <string name="folder_pattern_help">Prefix before the workspace name. Empty = automatic.</string>
    <string name="sync_folder">Sync folder</string>
    <string name="change_folder">Change folder</string>
    <string name="how_it_works">How it works</string>
    <string name="how_text">• Sync Suno → Player: fetches your library (workspaces, tracks, favorites, originals). Works on Free.\n• Sync local MP3 → Match with Suno: links your files to the tracks for playback.\n\nOn Free you don\'t “own” the songs in Suno\'s sense: their player decrypts them with a license, this app can\'t — so a track plays only through your local file (✅). 🫥 tracks have no file. On Pro you own your songs and the ⤓ button downloads them (quota).</string>
    <string name="section_data">Data</string>
    <string name="export_db">Export the database (JSON, all tags)</string>
    <string name="export_diag">Export a diagnostic (zip)</string>
    <string name="aa_help">Outside the Play Store: Android Auto → Settings → Version (tap 10×) → ⋮ → Developer settings → “Unknown sources”. The app then shows up in the car.</string>

